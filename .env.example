# PTN — Pakistan Trust Network
# Copy to .env and fill in values. Never commit real secrets.

# Application
PTN_ENV=development
PTN_DEBUG=true
PTN_APP_NAME=Pakistan Trust Network
PTN_API_URL=http://localhost:8000
PTN_FRONTEND_URL=http://localhost:3000
PTN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql+psycopg://ptn:ptn_dev_password@localhost:5432/ptn

# Security (generate strong random values for production)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
ENCRYPTION_KEY=change-me-fernet-key-32-url-safe-base64=

# Ledger
LEDGER_VALIDATOR_ID=ptn:validator:genesis
LEDGER_NODE_NAME=ptn-node-primary

# Rate limiting
RATE_LIMIT_PER_MINUTE=120

# Demo seed
SEED_DEMO_DATA=true
DEMO_PASSWORD=DemoPass123!

# Admin bootstrap (created only if no admin exists)
ADMIN_EMAIL=admin@ptn.demo
ADMIN_PASSWORD=AdminPass123!

# Git localhost mesh (no VPS)
PTN_NETWORK_ENABLED=true
PTN_NETWORK_GIT_URL=https://github.com/AmmarJamshed/pakistan-trust-network.git
PTN_NETWORK_GIT_BRANCH=main
# Optional: GitHub PAT with Contents write, if you are not a collaborator
PTN_NETWORK_GIT_TOKEN=
PTN_NETWORK_SYNC_SECONDS=60
