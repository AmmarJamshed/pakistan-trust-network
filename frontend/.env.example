# Optional. For `npm run dev` without Docker:
#   NEXT_PUBLIC_API_URL=http://localhost:8080
#   or http://localhost:8000 if the API uses that port.
#
# For Docker, leave this unset in the image. Compose builds with
# NEXT_PUBLIC_API_URL=same-origin so the browser talks to /api on
# whatever host you opened (localhost, LAN IP, or a public domain).
NEXT_PUBLIC_API_URL=http://localhost:8000
